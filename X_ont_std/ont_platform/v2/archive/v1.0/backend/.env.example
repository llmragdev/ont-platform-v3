# Gemini API 키 (셋 중 하나면 동작)
# GEMINI_API_KEY=your-key
# GEMINI_API_KEY1=AIza...
# GEMINI_API_KEY2=AIza...
# GEMINI_API_KEY3=AIza...

# 모델 (기본: gemini-2.0-flash-001)
# GEMINI_MODEL=gemini-2.0-flash-001

# 외부 .env 경로를 직접 지정하고 싶을 때
# DOTENV_PATH=F:/ai_std_dev/.env

# JSON 파일 영속화 (지정하지 않으면 인메모리)
# ONTOLOGY_DATA_PATH=./data/ontology.json
