# docker compose 실행 시 사용되는 환경 변수 모음 (선택)
# 실제 사용 시 `.env`로 복사 후 값을 채우세요.

# Gemini API 키 (셋 이상 있으면 키 로테이션이 동작)
# GEMINI_API_KEY=
# GEMINI_API_KEY1=
# GEMINI_API_KEY2=
# GEMINI_MODEL=gemini-2.0-flash-001

# 프론트엔드가 호출할 백엔드 주소 (브라우저에서 보이는 호스트 기준)
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# PostgreSQL 영속화 (NEXT_STEPS #6 도입 후)
# DATABASE_URL=postgresql://ontology:ontology@postgres:5432/ontology
