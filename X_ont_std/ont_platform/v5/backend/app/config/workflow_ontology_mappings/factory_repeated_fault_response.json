{
  "mapping_id": "factory.repeated_fault_response.v1",
  "mapping_version": "1.0.0",
  "name": "현장 고장 요청 정비 지시 온톨로지 매핑",
  "scenario_id": "factory-repeated-fault",
  "workflow_template_id": "factory-repeated-fault-response",
  "workflow_executor": "factory.repeated_fault_response",
  "summary": "현장 고장 요청을 공장, 라인, 공정, 설비, 고장 이력, 정비 지시서, 품질 영향 관계로 저장해 반복 고장과 후속 조치를 쉽게 추적합니다.",
  "ontology_document": {
    "doc_id": "factory-repeated-faults",
    "domain": "manufacturing"
  },
  "entity_types": [
    {
      "name": "ServiceRequest",
      "label": "현장 요청",
      "description": "현장 작업자, 품질 담당자, 설비 담당자가 등록한 요청입니다.",
      "properties": ["external_id", "category", "title", "content", "requester", "occurred_at", "severity", "status"]
    },
    {
      "name": "Factory",
      "label": "공장",
      "description": "생산 현장의 최상위 사업장 단위입니다.",
      "properties": ["site_code", "name", "location", "owner_team"]
    },
    {
      "name": "ProductionLine",
      "label": "생산 라인",
      "description": "공장 안에서 제품을 생산하는 라인입니다.",
      "properties": ["line_code", "name", "shift", "status"]
    },
    {
      "name": "ProcessStep",
      "label": "공정 단계",
      "description": "조립, 검사, 포장처럼 라인 안에서 수행되는 작업 단계입니다.",
      "properties": ["step_code", "name", "sequence", "status"]
    },
    {
      "name": "Equipment",
      "label": "설비",
      "description": "현장 요청과 연결되는 장비 또는 검사 장치입니다.",
      "properties": ["asset_id", "name", "model", "manufacturer", "status", "last_checked_at"]
    },
    {
      "name": "FaultEvent",
      "label": "고장 이력",
      "description": "특정 설비에서 관측된 고장 또는 이상 상황입니다.",
      "properties": ["fault_code", "message", "first_seen_at", "last_seen_at", "occurrence_count", "status", "severity"]
    },
    {
      "name": "MaintenanceTask",
      "label": "정비 지시서",
      "description": "정비팀이 확인하거나 처리해야 하는 작업 지시입니다.",
      "properties": ["task_id", "assigned_team", "priority", "status", "created_at", "due_at"]
    },
    {
      "name": "QualityIssue",
      "label": "품질 영향",
      "description": "설비 고장 이후 같은 라인에서 발견된 품질 이상 가능성입니다.",
      "properties": ["issue_id", "defect_type", "detected_at", "severity", "status"]
    }
  ],
  "relation_types": [
    { "name": "has_line", "label": "라인 보유", "from_type": "Factory", "to_type": "ProductionLine", "description": "공장이 생산 라인을 포함합니다." },
    { "name": "has_step", "label": "공정 보유", "from_type": "ProductionLine", "to_type": "ProcessStep", "description": "라인이 공정 단계를 포함합니다." },
    { "name": "uses", "label": "설비 사용", "from_type": "ProcessStep", "to_type": "Equipment", "description": "공정 단계에서 설비를 사용합니다." },
    { "name": "reports", "label": "고장 보고", "from_type": "ServiceRequest", "to_type": "FaultEvent", "description": "현장 요청이 고장 이력을 보고합니다." },
    { "name": "affects", "label": "설비 영향", "from_type": "FaultEvent", "to_type": "Equipment", "description": "고장 이력이 특정 설비에 영향을 줍니다." },
    { "name": "creates", "label": "정비 생성", "from_type": "FaultEvent", "to_type": "MaintenanceTask", "description": "고장 이력이 정비 지시서를 만듭니다." },
    { "name": "possibly_caused_by", "label": "원인 후보", "from_type": "QualityIssue", "to_type": "FaultEvent", "description": "품질 영향이 앞선 고장 이력과 관련될 수 있습니다." },
    { "name": "detected_by", "label": "검출 설비", "from_type": "QualityIssue", "to_type": "Equipment", "description": "품질 영향이 특정 설비에서 감지됩니다." },
    { "name": "affects_line", "label": "라인 영향", "from_type": "QualityIssue", "to_type": "ProductionLine", "description": "품질 영향이 생산 라인에 영향을 줍니다." }
  ],
  "workflow_node_mappings": [
    {
      "node_id": "request-input",
      "node_label": "현장 고장 요청 접수",
      "creates_or_updates": "ServiceRequest",
      "key": "request.external_id",
      "field_map": {
        "external_id": "request.id",
        "category": "request.category",
        "title": "request.title",
        "content": "request.message",
        "requester": "request.reporter",
        "occurred_at": "request.occurred_at",
        "severity": "request.severity",
        "status": "request.status"
      }
    },
    {
      "node_id": "asset-map",
      "node_label": "공장·라인·설비 식별",
      "creates_or_updates": "Factory, ProductionLine, ProcessStep, Equipment",
      "key": "request.factory_id + request.line_id + request.process_step_id + request.equipment_id",
      "field_map": {
        "factory": "request.factory_name",
        "line": "request.line_name",
        "step": "request.process_step_name",
        "equipment": "request.equipment_name"
      }
    },
    {
      "node_id": "recurrence-check",
      "node_label": "반복 고장 여부 확인",
      "creates_or_updates": "FaultEvent",
      "key": "request.equipment_id + normalized_fault_message",
      "field_map": {
        "message": "request.fault_message",
        "occurrence_count": "same_equipment_same_fault_count",
        "status": "observed_or_repeated",
        "severity": "request.severity"
      }
    },
    {
      "node_id": "maintenance-task",
      "node_label": "정비 지시서 생성",
      "creates_or_updates": "MaintenanceTask",
      "key": "fault_event_id",
      "field_map": {
        "assigned_team": "maintenance.assigned_team",
        "priority": "maintenance.priority",
        "status": "maintenance.status",
        "due_at": "maintenance.due_at"
      }
    },
    {
      "node_id": "quality-link",
      "node_label": "품질 영향 연결",
      "creates_or_updates": "QualityIssue",
      "key": "request.line_id + detected_at + defect_type",
      "field_map": {
        "defect_type": "quality.defect_type",
        "detected_at": "quality.detected_at",
        "severity": "quality.severity",
        "status": "quality.status"
      }
    }
  ],
  "relationship_mappings": [
    { "from": "Factory", "relation": "has_line", "to": "ProductionLine" },
    { "from": "ProductionLine", "relation": "has_step", "to": "ProcessStep" },
    { "from": "ProcessStep", "relation": "uses", "to": "Equipment" },
    { "from": "ServiceRequest", "relation": "reports", "to": "FaultEvent" },
    { "from": "FaultEvent", "relation": "affects", "to": "Equipment" },
    { "from": "FaultEvent", "relation": "creates", "to": "MaintenanceTask" },
    { "from": "QualityIssue", "relation": "possibly_caused_by", "to": "FaultEvent" },
    { "from": "QualityIssue", "relation": "detected_by", "to": "Equipment" },
    { "from": "QualityIssue", "relation": "affects_line", "to": "ProductionLine" }
  ],
  "sample_runtime_data": {
    "factory_name": "세종 배터리팩 공장",
    "line_name": "3번 조립 라인",
    "process_step_name": "배터리 탭 용접 공정",
    "equipment_name": "고속 탭 용접기 WT-17",
    "fault_message": "용접 압력이 기준보다 낮게 측정됨"
  },
  "setup_steps": [
    "공장 자동화 워크플로우 템플릿을 프로젝트로 복제합니다.",
    "온톨로지 매핑 템플릿을 프로젝트 온톨로지 스키마에 설치합니다.",
    "Factory, ProductionLine, ProcessStep, Equipment, FaultEvent 관계가 보이는지 확인합니다.",
    "샘플 현장 요청을 넣어 반복 고장, 정비 지시서, 품질 영향 연결을 시연합니다."
  ]
}
