{
  "mapping_id": "factory.repeated_fault_response.v1",
  "mapping_version": "1.0.0",
  "name": "공장 반복 고장 온톨로지 매핑",
  "scenario_id": "factory-repeated-fault",
  "workflow_template_id": "factory-repeated-fault-response",
  "workflow_executor": "factory.repeated_fault_response",
  "summary": "현장 요청을 공장-라인-공정-장비-고장-정비-품질 문제 관계로 묶어 반복 장애를 쉽게 볼 수 있게 저장합니다.",
  "ontology_document": {
    "doc_id": "factory-repeated-faults",
    "domain": "manufacturing"
  },
  "entity_types": [
    {
      "name": "ServiceRequest",
      "label": "현장 요청",
      "description": "작업자, 품질 담당자, 설비 담당자가 등록한 현장 요청입니다.",
      "properties": ["external_id", "category", "title", "content", "requester", "occurred_at", "severity", "status"]
    },
    {
      "name": "Factory",
      "label": "공장",
      "description": "생산 현장의 최상위 사업장입니다.",
      "properties": ["site_code", "location", "owner_team"]
    },
    {
      "name": "ProductionLine",
      "label": "생산 라인",
      "description": "공장 안의 생산 라인입니다.",
      "properties": ["line_code", "shift", "status"]
    },
    {
      "name": "ProcessStep",
      "label": "공정 단계",
      "description": "용접, 검사, 포장처럼 라인 안에서 수행되는 작업 단계입니다.",
      "properties": ["step_code", "sequence", "status"]
    },
    {
      "name": "Equipment",
      "label": "장비",
      "description": "배터리 탭 용접기, 검사 카메라 같은 현장 설비입니다.",
      "properties": ["asset_id", "model", "manufacturer", "status", "last_checked_at"]
    },
    {
      "name": "FaultEvent",
      "label": "고장 상황",
      "description": "같은 장비와 같은 문제로 묶이는 고장 상황입니다.",
      "properties": ["fault_code", "message", "first_seen_at", "last_seen_at", "occurrence_count", "status", "severity"]
    },
    {
      "name": "MaintenanceTask",
      "label": "정비 확인 건",
      "description": "정비팀이 확인해야 하는 작업 건입니다.",
      "properties": ["task_id", "assigned_team", "priority", "status", "created_at", "due_at"]
    },
    {
      "name": "QualityIssue",
      "label": "품질 문제",
      "description": "장비 고장 이후 같은 라인에서 발생한 품질 이상입니다.",
      "properties": ["issue_id", "defect_type", "detected_at", "severity", "status"]
    }
  ],
  "relation_types": [
    { "name": "has_line", "label": "라인 보유", "from_type": "Factory", "to_type": "ProductionLine", "description": "공장에 생산 라인이 포함됩니다." },
    { "name": "has_step", "label": "공정 보유", "from_type": "ProductionLine", "to_type": "ProcessStep", "description": "라인에 공정 단계가 포함됩니다." },
    { "name": "uses", "label": "사용", "from_type": "ProcessStep", "to_type": "Equipment", "description": "공정 단계에서 장비를 사용합니다." },
    { "name": "reports", "label": "신고", "from_type": "ServiceRequest", "to_type": "FaultEvent", "description": "현장 요청이 고장 상황을 신고합니다." },
    { "name": "affects", "label": "영향", "from_type": "FaultEvent", "to_type": "Equipment", "description": "고장 상황이 특정 장비에 영향을 줍니다." },
    { "name": "creates", "label": "생성", "from_type": "FaultEvent", "to_type": "MaintenanceTask", "description": "반복 고장이 정비 확인 건을 만듭니다." },
    { "name": "possibly_caused_by", "label": "원인 후보", "from_type": "QualityIssue", "to_type": "FaultEvent", "description": "품질 문제가 앞선 고장과 관련될 수 있습니다." },
    { "name": "detected_by", "label": "감지", "from_type": "QualityIssue", "to_type": "Equipment", "description": "품질 문제가 특정 장비로 감지됩니다." },
    { "name": "affects_line", "label": "라인 영향", "from_type": "QualityIssue", "to_type": "ProductionLine", "description": "품질 문제가 특정 생산 라인에 영향을 줍니다." }
  ],
  "workflow_node_mappings": [
    {
      "node_id": "request-input",
      "node_label": "현장 요청 입력",
      "creates_or_updates": "ServiceRequest",
      "key": "request.external_id",
      "field_map": {
        "category": "request.category",
        "occurred_at": "request.occurred_at",
        "severity": "request.severity"
      }
    },
    {
      "node_id": "asset-map",
      "node_label": "공장·라인·장비 매핑",
      "creates_or_updates": "Factory, ProductionLine, ProcessStep, Equipment",
      "key": "factory + line + step + equipment",
      "field_map": {
        "factory": "세종 배터리팩 공장",
        "line": "3번 조립 라인",
        "step": "용접 단계",
        "equipment": "배터리 탭 용접기"
      }
    },
    {
      "node_id": "recurrence-check",
      "node_label": "반복 여부 확인",
      "creates_or_updates": "FaultEvent",
      "key": "equipment + fault_message",
      "field_map": {
        "message": "압력이 낮습니다",
        "occurrence_count": "same_equipment_same_fault_count",
        "status": "observed or repeated"
      }
    },
    {
      "node_id": "maintenance-task",
      "node_label": "정비팀 확인 건 생성",
      "creates_or_updates": "MaintenanceTask",
      "key": "fault_event_id",
      "field_map": {
        "assigned_team": "정비팀",
        "priority": "high if repeated"
      }
    },
    {
      "node_id": "quality-link",
      "node_label": "품질 문제 연결",
      "creates_or_updates": "QualityIssue",
      "key": "line + detected_at + defect_type",
      "field_map": {
        "detected_by": "검사 카메라",
        "possibly_caused_by": "recent FaultEvent"
      }
    }
  ],
  "relationship_mappings": [
    { "from": "Factory", "relation": "has_line", "to": "ProductionLine" },
    { "from": "ProductionLine", "relation": "has_step", "to": "ProcessStep" },
    { "from": "ProcessStep", "relation": "uses", "to": "Equipment" },
    { "from": "ServiceRequest", "relation": "reports", "to": "FaultEvent" },
    { "from": "FaultEvent", "relation": "affects", "to": "Equipment" },
    { "from": "FaultEvent", "relation": "creates", "to": "MaintenanceTask" },
    { "from": "QualityIssue", "relation": "possibly_caused_by", "to": "FaultEvent" },
    { "from": "QualityIssue", "relation": "detected_by", "to": "Equipment" },
    { "from": "QualityIssue", "relation": "affects_line", "to": "ProductionLine" }
  ],
  "setup_steps": [
    "공장 반복 고장 워크플로우 템플릿을 프로젝트로 복제합니다.",
    "이 매핑 템플릿을 프로젝트 온톨로지 스키마에 설치합니다.",
    "Factory/ProductionLine/Equipment/FaultEvent 관계가 보이는지 확인합니다.",
    "샘플 현장 요청 2~3건을 넣어 반복 고장과 품질 문제 연결을 시연합니다."
  ]
}
